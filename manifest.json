{
    "manifest_version": 3,
    "name": "VideoFlex - Advanced video controls",
    "version": "1.0.0",
    "description": "Resize HTML5 videos without changing their aspect ratio, reduce black bars, adjust visual filters and playback speed, and control everything with an on-video menu or keyboard shortcuts.",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true,
            "match_origin_as_fallback": true,
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}